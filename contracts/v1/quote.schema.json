{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bqatlas:contracts:1:quote",
  "title": "Quote write contract",
  "type": "object",
  "required": [
    "customerId",
    "date",
    "currency",
    "lines"
  ],
  "properties": {
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "enum": [
        "USD",
        "EUR",
        "BDT"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$",
            "description": "Greater than zero and no more than 1000000."
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$",
            "description": "From zero to 1000000000 inclusive."
          }
        }
      }
    }
  },
  "description": "Server ignores undeclared input properties. Amounts are decimal strings. Lines round half away from zero to 2 places before summing. Duplicate line IDs, inactive/missing customers and invalid calendar dates are rejected by application validation."
}
