BQATLAS_ENVIRONMENT=Development
BQATLAS_DATABASE_PROVIDER=postgresql
BQATLAS_DATABASE_URL=postgres://bqatlas:bqatlas-rust-dev-only@127.0.0.1:25433/bqatlas_rust_dev
BQATLAS_LISTEN=127.0.0.1:5201
BQATLAS_AUTH_MODE=local
BQATLAS_BOOTSTRAP_EMAIL=admin@bqatlas.local
BQATLAS_BOOTSTRAP_PASSWORD=RustAtlas-Dev!2026

# Opt-in Development account recovery (files are private and ignored).
BQATLAS_DEV_MAIL_DIR=.local-mail
BQATLAS_PUBLIC_ORIGIN=http://127.0.0.1:4300
# To use the isolated Keycloak demo, set BQATLAS_AUTH_MODE=oidc and these values:
# BQATLAS_OIDC_ISSUER=http://127.0.0.1:28182/realms/bqatlas-rust
# BQATLAS_OIDC_CLIENT_ID=bqatlas-rust
# BQATLAS_OIDC_CLIENT_SECRET=rust-oidc-dev-only
# BQATLAS_OIDC_ROLE_FILE=dev/oidc-roles.json
